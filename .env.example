# Firebase web app config (project: cisa-cal).
# Copy to .env.local and fill apiKey + appId from the Firebase console:
#   Project settings → General → Your apps → Web app → SDK setup and configuration.
# The Firebase web API key is NOT a secret (it identifies the project), but it is required.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=

# These have sensible defaults derived from the project; override only if different.
VITE_FIREBASE_AUTH_DOMAIN=cisa-cal.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=cisa-cal
VITE_FIREBASE_STORAGE_BUCKET=cisa-cal.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=50267769259

# The fixed shared "member" Firebase Auth account. Its password IS the shared
# password handed to general users. Create this Email/Password user in the
# Firebase console and keep this email in sync with firestore.rules.
VITE_MEMBER_EMAIL=members@cisa-cal.web.app
