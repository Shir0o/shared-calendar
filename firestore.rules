rules_version = '2';

// Shared Team Calendar — access tiers:
//   member : signed in as the shared member account (email == MEMBER_EMAIL) → view + create
//   admin  : Google user whose email has an approved doc in /admins        → full edit
//   owner  : Google user with the hardcoded owner email                    → full edit + manage admins
//
// Keep MEMBER_EMAIL / OWNER_EMAIL in sync with src/lib/firebase.ts.
service cloud.firestore {
  match /databases/{database}/documents {

    function MEMBER_EMAIL() { return 'members@cisa-cal.web.app'; }
    function OWNER_EMAIL()  { return 'yilongwang05@gmail.com'; }

    function signedIn()   { return request.auth != null; }
    function userEmail()  { return request.auth.token.email; }
    function emailKey()   { return request.auth.token.email.lower(); }
    function isMember()   { return signedIn() && userEmail().lower() == MEMBER_EMAIL(); }
    function isOwner()    { return signedIn() && userEmail().lower() == OWNER_EMAIL(); }
    function isAdmin()    { return isOwner() || (signedIn() && exists(/databases/$(database)/documents/admins/$(emailKey())) && get(/databases/$(database)/documents/admins/$(emailKey())).data.approved == true); }

    // Events: anyone signed in can read; members + admins can create;
    // only admins/owner can update or delete.
    match /events/{id} {
      allow read:   if signedIn();
      allow create: if isMember() || isAdmin();
      allow update, delete: if isAdmin();
    }

    // Admin list: readable by any admin; writable only by the owner.
    match /admins/{id} {
      allow read:  if isAdmin();
      allow write: if isOwner();
    }

    // Access requests: a Google user may create/read their own request;
    // the owner can read and delete any request.
    match /accessRequests/{id} {
      allow read:   if isOwner() || (signedIn() && id == emailKey());
      allow create: if signedIn() && id == emailKey();
      allow delete: if isOwner();
    }
  }
}
